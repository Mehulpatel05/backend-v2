# ==========================================================
# 🚀 NEARHOOD BACKEND V2 ENVIRONMENT TEMPLATE (.env.example)
# ==========================================================

# Server & Runtime
PORT=3000
ENVIRONMENT=production
NODE_ENV=production
CORS_ORIGIN=*

# JWT & Authentication Secret Keys
JWT_SECRET=nearhood_jwt_secret_v2_super_secure_2026_x89a
TOKEN_EXPIRY_DAYS=30

# Cloudflare D1 SQL Database Credentials
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=nearhood-d1-db-id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Cloudflare R2 Object Storage (Per-User Folder Media)
CLOUDFLARE_R2_BUCKET_NAME=nearhood-media
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://media.nearhood.in

# Firebase Cloud Messaging (FCM Push Notifications)
FIREBASE_PROJECT_ID=vadodara-local
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@vadodara-local.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# SMS Gateway (Fast2SMS DLT SMS OTP)
FAST2SMS_API_KEY=your_fast2sms_authorization_key_here
FAST2SMS_ROUTE=q
FAST2SMS_BASE_URL=https://www.fast2sms.com/dev/bulkV2
FAST2SMS_SENDER_ID=your_approved_6_char_sender_id
FAST2SMS_TEMPLATE_ID=your_approved_dlt_template_message_id

DEFAULT_OTP=123456

